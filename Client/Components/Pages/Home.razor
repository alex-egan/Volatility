@using Client.Api.Generated;
@using Microsoft.AspNetCore.SignalR.Client
@using MudBlazor
@inject NavigationManager NavigationManager
@inject Net80 ApiClient;
@inject ISnackbar Snackbar;
@page "/"

<PageTitle>Home</PageTitle>
@if (_isLoading) 
{
    <MudContainer Gutters="false" Class="d-flex align-center justify-center">
        <MudProgressCircular Indeterminate Color="Color.Primary" />
    </MudContainer>
}
else 
{
    <MudTable Items="_drinks" OnRowClick="@(async (TableRowClickEventArgs<Drink> args) => await OpenDrinkAsync(args.Item!.Id))">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Code</MudTh>
            <MudTh>Current Price</MudTh>
            <MudTh>
                <MudIconButton OnClick="CreateDrinkAsync" Icon="@Icons.Material.Filled.Add" Color="Color.Success" />
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Price.ToString("0.00")</MudTd>
            <MudTd>
                <MudIconButton Disabled="@(!context.Active)" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Money" OnClick="@(async () => await PurchaseAsync(context.Id))" />
                <MudIconButton Variant="Variant.Filled" Color="Color.Default" Icon="@Icons.Material.Filled.Cancel" OnClick="@(async () => await DeactivateAsync(context.Id))" />
                <MudIconButton Variant="Variant.Filled" Color="Color.Error" Icon="@Icons.Material.Filled.Delete" OnClick="@(async () => await DeleteAsync(context.Id))" />
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (_selectedDrink != null) 
    {
        <MudContainer Gutters="false" Class="d-flex flex-column mb-2">
            <MudText Typo="Typo.h4">@_selectedDrink.Name</MudText>
        </MudContainer>
        <MudContainer Gutters="false" Class="d-flex ma-4">
            <MudChart @ref="@_chart"  T="decimal" ChartType="ChartType.Line" ChartOptions="_options" ChartSeries="_series" />
        </MudContainer>
    }
}

@code {
    private List<Drink> _drinks = [];
    private bool _isLoading = true;
    private Drink? _selectedDrink = null;
    private HubConnection? connection;
    private MudChart<decimal>? _chart = null!;

    private LineChartOptions _options = new LineChartOptions()
    {
        XAxisTitle = "Dates",
        YAxisTitle = "Price",
        ShowDataMarkers = true
    };

    private List<ChartSeries<decimal>> _series = [];

    protected override async Task OnInitializedAsync() 
    {
        connection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("https://localhost:7184/drinkhub"))
            .WithAutomaticReconnect()
            .Build();

        connection.On<Drink>("DrinkCreated", async (beverage) =>
        {
            if (!_drinks.Any(b => b.Id == beverage.Id)) 
            {
                _drinks.Add(beverage);
                await InvokeAsync(StateHasChanged);
            }
        });

        connection.On<Guid, decimal>("BeveragePurchased", async (id, price) => 
        {
            await InvokeAsync(() =>
            {
                int index = _drinks.FindIndex(b => b.Id == id);
                if (index != -1)
                {
                    _drinks[index].Price = price;

                    if (_selectedDrink?.Id == id && _chart != null)
                    {
                        Console.WriteLine("Updating chart prices.");

                        var series = _series.First();
                        ChartSeries<decimal> chartSeries = new() 
                        {
                            Data = new ChartData<decimal>(series.Data.Append(price).ToList())
                        };

                        _chart.ChartSeries[0] = chartSeries;
                        _chart.RebuildChart();
                    }

                    StateHasChanged();
                }
            });
        });

        connection.On<Dictionary<Guid, decimal>>("PricesUpdated", async (updated) => 
        {
            await InvokeAsync(() =>
            {
                _drinks = _drinks.Select(b => 
                {
                    bool success = updated.TryGetValue(b.Id, out decimal price);
                    if (success) b.Price = price;
                    return b;
                }).ToList();

                if (updated.Any(b => b.Key == _selectedDrink?.Id) && _chart != null) 
                {
                    decimal price = updated[_selectedDrink!.Id];
                    var series = _series.First();
                    ChartSeries<decimal> chartSeries = new() 
                    {
                        Data = new ChartData<decimal>(series.Data.Append(price).ToList())
                    };

                    _chart.ChartSeries[0] = chartSeries;
                    _chart.RebuildChart();
                }

                StateHasChanged();
            });
        });

        await connection.StartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) 
    {
        if (!firstRender) return;

        try
        {
            ICollection<Drink> drinks = (await ApiClient.GetAsync()).OrderBy(b => b.Active.ToString()).ToList();
            _drinks = drinks.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Could not retrieve forecasts.", Severity.Error);
            Console.WriteLine(ex);
        }

        _isLoading = false;
       await InvokeAsync(StateHasChanged);
    }

    private async Task CreateDrinkAsync() 
    {
        Drink drink = new() 
        {
            Id = Guid.NewGuid(),
            Name = "Test Beer",
            Code = "Test",
            Type = BeverageType.Beer,
            Price = 6.50m,
            MinPrice = 1.50m,
            MaxPrice = 25.0m,
            BasePrice = 8.0m,
            AvailableContainers = [ BeverageContainerType.Can, BeverageContainerType.Draft ],
            Active = true
        };

        try 
        {
            await ApiClient.CreateAsync(drink);
        }
        catch (Exception exception) 
        {
            Snackbar.Add($"Could not save beverage: {exception}");
            Console.WriteLine(exception);
            return;
        }
        
        _drinks.Add(drink);
        Snackbar.Add($"Beverage {drink.Name} successfully created.");
        StateHasChanged();
    }

    private async Task OpenDrinkAsync(Guid id) 
    {
        try 
        {
            _selectedDrink = await ApiClient.GetByIdAsync(id);
            IEnumerable<DrinkEvent> events = _selectedDrink.Events.OrderBy(e => e.PerformedOn);
            decimal[] series = events.Select(e => (Math.Truncate(e.Price * 100) / 100)).ToArray();
            
            _series = [
                new() { Name = _selectedDrink.Name, Data = series }
            ];

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception) 
        {
            Snackbar.Add($"Could not retrieve beverage {id}, {exception}", Severity.Error);
        }
    }

    private async Task PurchaseAsync(Guid id) 
    {
        try 
        {
            await ApiClient.PurchaseAsync(id);
            StateHasChanged();
        } 
        catch (Exception exception) 
        {
            Console.WriteLine($"Exception encountered: {exception}");
        }
    }

    private async Task DeactivateAsync(Guid id) 
    {
        try 
        {
            await ApiClient.DeactivateAsync(id);

            Drink? drink = _drinks.FirstOrDefault(b => b.Id == id);
            if (drink is null) return;

            drink.Active = false;
            Snackbar.Add("Successfully deactivated beverage.");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception) 
        {
            Snackbar.Add($"Unable to deactivate beverage: {exception}", Severity.Error);
        }
    }

    private async Task DeleteAsync(Guid id) 
    {
        try 
        {
            await ApiClient.DeleteAsync(id);
            int index = _drinks.FindIndex(b => b.Id == id);
            _drinks.RemoveAt(index);
            Snackbar.Add("Successfully deleted beverage.");
            StateHasChanged();
        }
        catch (Exception exception) 
        {
            Snackbar.Add($"Unable to deactivate beverage: {exception}", Severity.Error);
        }
    }
}