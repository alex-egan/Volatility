@using Client.Api.Generated;
@using MudBlazor
@inject Net80 ApiClient;
@inject ISnackbar Snackbar;
@page "/"

<PageTitle>Home</PageTitle>
@if (_isLoading) 
{
    <MudContainer Gutters="false" Class="d-flex align-center justify-center">
        <MudProgressCircular Indeterminate Color="Color.Primary" />
    </MudContainer>
}
else 
{
    <MudTable Items="_beverages">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Code</MudTh>
            <MudTh>Current Price</MudTh>
            <MudTh>
                <MudIconButton OnClick="CreateDrinkAsync" Icon="@Icons.Material.Filled.Add" Color="Color.Success" />
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Price.ToString("0.00")</MudTd>
            <MudTd>
                <MudIconButton Disabled="@(!context.Active)" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Money" OnClick="@(async () => await PurchaseAsync(context.Id))" />
                <MudIconButton Variant="Variant.Filled" Color="Color.Default" Icon="@Icons.Material.Filled.Cancel" OnClick="@(async () => await DeactivateAsync(context.Id))" />
                <MudIconButton Variant="Variant.Filled" Color="Color.Error" Icon="@Icons.Material.Filled.Delete" OnClick="@(async () => await DeleteAsync(context.Id))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<Beverage> _beverages = [];
    private bool _isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender) 
    {
        if (!firstRender) return;

        try
        {
            ICollection<Beverage> beverages = (await ApiClient.GetAsync()).OrderBy(b => b.Active.ToString()).ToList();
            
            _beverages = beverages.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Could not retrieve forecasts.", Severity.Error);
            Console.WriteLine(ex);
        }

        _isLoading = false;
       await InvokeAsync(StateHasChanged);
    }

    private async Task CreateDrinkAsync() 
    {
        Beverage beverage = new() 
        {
            Id = Guid.NewGuid(),
            Name = "Test Beer",
            Code = "Test",
            Type = BeverageType.Beer,
            Price = 6.50m,
            AvailableContainers = [ BeverageContainerType.Can, BeverageContainerType.Draft ],
            Active = true
        };

        try 
        {
            await ApiClient.CreateAsync(beverage);
        }
        catch (Exception exception) 
        {
            Snackbar.Add($"Could not save beverage: {exception}");
            Console.WriteLine(exception);
            return;
        }
        
        _beverages.Add(beverage);
        Snackbar.Add($"Beverage {beverage.Name} successfully created.");
        StateHasChanged();
    }

    private async Task PurchaseAsync(Guid id) 
    {
        try 
        {
            Beverage updated = await ApiClient.PurchaseAsync(id);
            int index = _beverages.FindIndex(b => b.Id == updated.Id);
            _beverages[index] = updated;
            StateHasChanged();
        } 
        catch (Exception exception) 
        {
            Console.WriteLine($"Exception encountered: {exception}");
        }
    }

    private async Task DeactivateAsync(Guid id) 
    {
        try 
        {
            await ApiClient.DeactivateAsync(id);

            Beverage? beverage = _beverages.FirstOrDefault(b => b.Id == id);
            if (beverage is null) return;

            beverage.Active = false;
            Snackbar.Add("Successfully deactivated beverage.");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception) 
        {
            Snackbar.Add($"Unable to deactivate beverage: {exception}", Severity.Error);
        }
    }

    private async Task DeleteAsync(Guid id) 
    {
        try 
        {
            await ApiClient.DeleteAsync(id);
            int index = _beverages.FindIndex(b => b.Id == id);
            _beverages.RemoveAt(index);
            Snackbar.Add("Successfully deleted beverage.");
            StateHasChanged();
        }
        catch (Exception exception) 
        {
            Snackbar.Add($"Unable to deactivate beverage: {exception}", Severity.Error);
        }
    }
}
